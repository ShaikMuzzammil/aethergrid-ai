# ─── Database (Neon PostgreSQL — free at neon.tech) ───────────────────────────
# Pooled connection (use this for DATABASE_URL)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection (use this for DIRECT_URL)
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-long-random-secret-at-least-32-chars"

# Your app URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"
# For Vercel production: NEXTAUTH_URL="https://your-project.vercel.app"

# ─── Optional: SMTP (for team invite emails) ──────────────────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="AetherGrid AI <noreply@aethergrid.ai>"
