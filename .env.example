# ─── AetherGrid AI — Environment Variables ───────────────────────────────────
# Copy this file to .env.local for local development
# Set all variables in Vercel Dashboard > Project > Settings > Environment Variables

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
# Get from: https://neon.tech  (Free tier: 0.5 GB, no credit card)
# 1. Create project → choose region closest to Vercel (usually US East)
# 2. Click "Connect" → copy "Pooled connection" string for DATABASE_URL
# 3. Copy "Direct connection" string for DIRECT_URL

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb"

# ─── Auth (REQUIRED) ─────────────────────────────────────────────────────────
# Generate NEXTAUTH_SECRET with:  openssl rand -base64 32
# (On Windows PowerShell):        [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

NEXTAUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="https://your-app-name.vercel.app"
# For local dev use: NEXTAUTH_URL="http://localhost:3000"

# ─── Optional Integrations ──────────────────────────────────────────────────
# All optional — app works 100% without these.
# Add them to unlock specific integration tiles in the dashboard.

# Slack (Free) — https://api.slack.com/apps
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# SendGrid Email (Free 100/day) — https://sendgrid.com
# SENDGRID_API_KEY="SG.xxxxx"

# Mapbox (Free 50k tiles/mo) — https://mapbox.com
# NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1Ijo..."

# ─── Notes ───────────────────────────────────────────────────────────────────
# The build command (vercel.json) automatically runs:
#   prisma generate && prisma db push && next build
# This creates all database tables on every deploy — no manual migration needed.
#
# Demo account auto-created on first login:
#   Email:    demo@aethergrid.ai
#   Password: DemoPass123!
