generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum DeviceType {
  ESP32
  ESP8266
  RASPBERRY_PI
  NVIDIA_JETSON
  STM32
  RISCV
  ARDUINO
  CUSTOM
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
  ERROR
  MAINTENANCE
}

enum CommandStatus {
  PENDING
  SENT
  EXECUTED
  FAILED
  TIMEOUT
}

enum AlertType {
  CONNECTIVITY
  PERFORMANCE
  SECURITY
  HARDWARE
  FIRMWARE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ModelType {
  OBJECT_DETECTION
  IMAGE_SEGMENTATION
  CLASSIFICATION
  ANOMALY_DETECTION
  NLP
  TIME_SERIES
  RECOMMENDATION
  GENERATIVE
}

enum MLFramework {
  TENSORFLOW
  PYTORCH
  ONNX
  TFLITE
  OPENVINO
  CUSTOM
}

enum ModelStatus {
  DRAFT
  TRAINING
  TRAINED
  DEPLOYED
  ARCHIVED
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeploymentType {
  API_SERVICE
  MODEL_SERVING
  WEB_APP
  BACKGROUND_WORKER
  DATA_PIPELINE
  EDGE_FUNCTION
}

enum DeploymentStatus {
  PENDING
  DEPLOYING
  RUNNING
  STOPPED
  FAILED
  UPDATING
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  CSV
  JSON
  PARQUET
  XLSX
}

enum NotificationType {
  SYSTEM
  DEVICE_ALERT
  MODEL_COMPLETE
  DEPLOYMENT
  SECURITY
  TEAM
}

enum AutomationCategory {
  MONITORING
  MAINTENANCE
  INTEGRATION
  SCALING
  REPORTING
  ML_OPS
  SAFETY
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  role             UserRole       @default(USER)
  twoFactorEnabled Boolean        @default(false)
  bio              String?
  timezone         String?        @default("UTC")
  language         String?        @default("en")
  theme            String?        @default("dark")
  notifyEmail      Boolean        @default(true)
  notifyPush       Boolean        @default(true)
  notifySlack      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  accounts          Account[]
  sessions          Session[]
  devices           Device[]
  aiModels          AiModel[]
  deployments       Deployment[]
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  exportJobs        ExportJob[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  teamMembers       TeamMember[]
  automations       Automation[]
  integrations      Integration[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Device Models ───────────────────────────────────────────────────────────

model Device {
  id              String       @id @default(cuid())
  name            String
  type            DeviceType
  status          DeviceStatus @default(OFFLINE)
  firmwareVersion String?
  ipAddress       String?
  macAddress      String?
  location        String?
  latitude        Float?
  longitude       Float?
  cpu             Float?       @default(0)
  memory          Float?       @default(0)
  temperature     Float?
  tags            String[]
  metadata        Json?
  lastSeen        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  userId          String
  groupId         String?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          DeviceGroup?   @relation(fields: [groupId], references: [id])
  sensorReadings SensorReading[]
  commands       DeviceCommand[]
  alerts         DeviceAlert[]
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices Device[]
}

model SensorReading {
  id        String   @id @default(cuid())
  deviceId  String
  metric    String
  value     Float
  unit      String?
  quality   Int?     @default(100)
  timestamp DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, metric, timestamp])
}

model DeviceCommand {
  id         String        @id @default(cuid())
  deviceId   String
  command    String
  payload    Json?
  status     CommandStatus @default(PENDING)
  response   Json?
  sentAt     DateTime      @default(now())
  executedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model DeviceAlert {
  id         String        @id @default(cuid())
  deviceId   String
  type       AlertType
  severity   AlertSeverity
  message    String
  resolved   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

// ─── AI / ML Models ──────────────────────────────────────────────────────────

model AiModel {
  id          String      @id @default(cuid())
  name        String
  version     String      @default("1.0.0")
  type        ModelType
  framework   MLFramework
  description String?
  accuracy    Float?
  size        Int?
  latency     Float?
  status      ModelStatus @default(DRAFT)
  tags        String[]
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingJobs      TrainingJob[]
  deployments       Deployment[]
  inferenceRequests InferenceRequest[]
}

model TrainingJob {
  id           String    @id @default(cuid())
  modelId      String
  name         String
  status       JobStatus @default(QUEUED)
  progress     Int       @default(0)
  epochs       Int?
  batchSize    Int?
  learningRate Float?
  accuracy     Float?
  loss         Float?
  config       Json?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model InferenceRequest {
  id        String   @id @default(cuid())
  modelId   String
  input     Json
  output    Json?
  latency   Float?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

// ─── Deployment Models ───────────────────────────────────────────────────────

model Deployment {
  id          String           @id @default(cuid())
  name        String
  type        DeploymentType
  status      DeploymentStatus @default(PENDING)
  modelId     String?
  config      Json?
  url         String?
  region      String?          @default("us-east-1")
  replicas    Int              @default(1)
  cpuLimit    String?
  memoryLimit String?
  cpuUsage    Float?           @default(0)
  memoryUsage Float?           @default(0)
  reqPerMin   Int?             @default(0)
  errorRate   Float?           @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      String

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  model   AiModel?          @relation(fields: [modelId], references: [id])
  logs    DeploymentLog[]
  metrics DeploymentMetric[]
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  level        String     @default("info")
  message      String
  timestamp    DateTime   @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model DeploymentMetric {
  id           String     @id @default(cuid())
  deploymentId String
  metric       String
  value        Float
  timestamp    DateTime   @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

// ─── Automation ───────────────────────────────────────────────────────────────

model Automation {
  id          String             @id @default(cuid())
  name        String
  description String?
  category    AutomationCategory @default(MONITORING)
  active      Boolean            @default(true)
  triggerType String
  triggerConfig Json
  actionType  String
  actionConfig Json
  runCount    Int                @default(0)
  lastRun     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Integrations ─────────────────────────────────────────────────────────────

model Integration {
  id          String            @id @default(cuid())
  name        String
  provider    String
  status      IntegrationStatus @default(DISCONNECTED)
  config      Json?
  credentials Json?
  lastSync    DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── API Keys & Webhooks ─────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  key         String    @unique
  prefix      String
  userId      String
  permissions String[]
  lastUsed    DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  events    String[]
  secret    String?
  active    Boolean  @default(true)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id        String   @id @default(cuid())
  webhookId String
  event     String
  payload   Json
  status    Int?
  response  String?
  duration  Float?
  createdAt DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

// ─── Export Jobs ─────────────────────────────────────────────────────────────

model ExportJob {
  id          String       @id @default(cuid())
  name        String
  format      ExportFormat @default(CSV)
  dataType    String       @default("devices")
  status      ExportStatus @default(PENDING)
  fileUrl     String?
  fileSize    Int?
  rowCount    Int?
  config      Json?
  userId      String
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Notifications & Audit ───────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Team Models ─────────────────────────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  plan        String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     TeamMember[]
  invitations TeamInvitation[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(MEMBER)
  token     String   @unique
  accepted  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
